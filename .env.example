# Application key. Generate a real value with: php artisan key:generate
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY

# Base URL the app is served from. Short links are built from this host.
APP_URL=http://localhost

# Debug mode. Keep false outside local development; must be false in production.
APP_DEBUG=false

# Database driver. This project targets MySQL.
DB_CONNECTION=mysql

# Database host. Use the Sail service name "mysql" when running via Docker.
DB_HOST=mysql

# Database port.
DB_PORT=3306

# Database name.
DB_DATABASE=shortlink

# Database user.
DB_USERNAME=sail

# Database password. Use a strong value; never commit real credentials.
DB_PASSWORD=change_me_dummy_password
